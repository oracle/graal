+fn parse_explicit_target(args: &[String]) -> Option<String> {
+    let mut explicit_target = None;
+    let mut i = 0;
+    while i < args.len() {
+        let arg = &args[i];
+        if let Some(target) = arg.strip_prefix("--target=") {
+            explicit_target = Some(target.to_string());
+        } else if arg == "--target" && i + 1 < args.len() {
+            i += 1;
+            explicit_target = Some(args[i].clone());
+        }
+        i += 1;
+    }
+    explicit_target
+}
+
+fn get_sandbox_mode(args: &[String]) -> SandboxMode {
+    parse_explicit_target(args)
+        .as_deref()
+        .map(SandboxMode::from_target_name)
+        .unwrap_or(SandboxMode::OFF)
+}
