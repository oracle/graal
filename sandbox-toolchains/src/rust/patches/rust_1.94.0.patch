+/// Sandbox mode derived from the compilation target.
+#[derive(Clone, Copy, PartialEq, Hash, Debug)]
+#[repr(C)]
+pub enum SandboxMode {
+    OFF,
+    SWCFI,
+    HWCFI,
+}
+
+impl SandboxMode {
+    pub fn from_target_name(target: &str) -> Self {
+        if target == "x86_64-graalos_swcfi-linux-musl" {
+            Self::SWCFI
+        } else if target == "x86_64-graalos_hwcfi-linux-musl" {
+            Self::HWCFI
+        } else {
+            Self::OFF
+        }
+    }
+
+    pub fn from_target_triple(target: &TargetTuple) -> Self {
+        Self::from_target_name(target.tuple())
+    }
+
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::OFF => "off",
+            Self::SWCFI => "swcfi",
+            Self::HWCFI => "hwcfi",
+        }
+    }
+}
+
